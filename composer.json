{
  "name": "teamdma/dma-internlink-mapper",
  "description": "Development tooling and tests for DMA InternLink Mapper.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "php tools/php-lint.php",
    "audit:security": "php tools/security-invariants.php",
    "test": "phpunit --configuration phpunit.xml.dist",
    "phpcs:security": "phpcs --standard=phpcs.xml.dist --warning-severity=0",
    "phpcs:compat": "phpcs --standard=phpcs-compat.xml.dist --warning-severity=0"
  }
}
